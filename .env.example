# Recommended local-first mode: SQLite is primary and PostgreSQL is a one-way cloud mirror.
EASYSCHED_CLOUD_DATABASE_URL=postgresql://db_user:db_password@db_host:5432/easysched?sslmode=require

# Optional cloud-only mode (requires internet for every operation):
# EASYSCHED_DATABASE_URL=postgresql://db_user:db_password@db_host:5432/easysched?sslmode=require

# Local fallback mode (leave EASYSCHED_DATABASE_URL empty):
# EASYSCHED_DB_PATH=data/easysched.sqlite

# Production HTTPS. Leave both unset for local http://localhost development.
# EASYSCHED_FORCE_HTTPS=1
# EASYSCHED_TRUST_PROXY=1
